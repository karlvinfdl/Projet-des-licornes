{% extends 'base.html.twig' %}

{% block title %}Fête des Licornes{% endblock %}

{% block body %}

<!-- ===================== -->
<!-- COLONNE DROITE -->
<!-- ===================== -->
<main class="right-col">

  <!-- Carte titre -->
  <section class="card card-title">
    <h1>Bienvenue à la<br>Fête des Licornes !</h1>
  </section>

  <!-- Formulaire -->
  <section class="card card-form">
    <h2>Formulaire</h2>

    <form method="post">
      <label>
        <span>Nom :</span>
        <input name="nom" type="text" required>
      </label>

      <label>
        <span>Prénom :</span>
        <input name="prenom" type="text" required>
      </label>

      <label>
        <span>Age :</span>
        <input name="age" type="number" min="0" max="120" required>
      </label>

      <label>
        <span>Email :</span>
        <input name="email" type="email" required>
      </label>

      <label>
        <span>Ville :</span>
        <input name="ville" type="text" required>
      </label>

      <button class="btn" type="submit">Envoyer</button>
    </form>

  </section>

  <!-- Bouton équipe -->
  <button class="big-btn" id="teamBtn">Découvrir l'équipe</button>

</main>

{% endblock %}

